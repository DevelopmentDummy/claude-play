{
  "description": "배경화면 전용 16:9 Anima 장면 (1536x864) — 선택형 Turbo LoRA + UNET/CLIP/디테일러/업스케일 체인. 인물+배경 풀씬용.",
  "compatibility": {
    "requires": {
      "loader": "unet_only"
    },
    "incompatible_message": "anima-background는 UNET/CLIP 분리 로드 체크포인트만 지원합니다. 단일 세이프텐서 체크포인트는 'scene_background' 패키지를 사용하세요."
  },
  "features": {
    "checkpoint_auto": false,
    "lora_injection": true,
    "lora_couple_branches": false,
    "seed_randomize": true,
    "trigger_tags": true,
    "detailer_chain": true
  },
  "detailer_chain": {
    "source": {
      "node": "9",
      "output": 0
    },
    "sink": {
      "node": "30",
      "field": "image"
    }
  },
  "params": {
    "subject_tags": {
      "type": "string",
      "required": true,
      "description": "Danbooru/Gelbooru 스타일 주제 태그"
    },
    "scene_prompt": {
      "type": "string",
      "required": true,
      "description": "자연어 장면 설명"
    },
    "meta_tags": {
      "type": "string",
      "default": "safe, highres",
      "description": "안전/메타 태그"
    },
    "negative_prompt": {
      "node": "5",
      "field": "text",
      "type": "string",
      "default": "",
      "description": "네거티브 프롬프트"
    },
    "width": {
      "node": "6",
      "field": "width",
      "type": "number",
      "default": 1536
    },
    "height": {
      "node": "6",
      "field": "height",
      "type": "number",
      "default": 864
    },
    "steps": {
      "node": "8",
      "field": "steps",
      "type": "number",
      "default": 36
    },
    "cfg": {
      "node": "8",
      "field": "cfg",
      "type": "number",
      "default": 4.5
