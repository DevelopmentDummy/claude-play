    },
    "clip_type": {
      "node": "2",
      "field": "type",
      "type": "string",
      "default": "stable_diffusion"
    },
    "vae_name": {
      "node": "3",
      "field": "vae_name",
      "type": "string",
      "default": "qwen_image_vae.safetensors"
    },
    "system_prefix": {
      "type": "string",
