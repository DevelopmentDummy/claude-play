{
  "description": "Krea2 Turbo NSFW AIO FP8 전용 텍스트→이미지 패키지. 내장 Qwen3-VL 4B 텍스트 인코더와 VAE를 CheckpointLoaderSimple로 함께 로드하며, Turbo 권장 CFG 1과 ConditioningZeroOut 네거티브를 사용한다.",
  "features": {
    "checkpoint_auto": false,
    "lora_injection": false,
    "lora_couple_branches": false,
    "seed_randomize": true,
    "trigger_tags": false
  },
  "params": {
    "checkpoint": {
      "node": "1",
      "field": "ckpt_name",
      "type": "string",
      "default": "krea2_turbo_nsfw_aio_fp8.safetensors",
      "description": "Krea2 AIO 체크포인트 파일명"
    },
    "prompt": {
      "node": "2",
      "field": "text",
      "type": "string",
      "required": true,
      "description": "자연어 장면 프롬프트"
    },
    "width": {
      "node": "4",
      "field": "width",
      "type": "number",
      "default": 1024
    },
    "height": {
      "node": "4",
      "field": "height",
      "type": "number",
      "default": 1024
    },
    "batch_size": {
      "node": "4",
      "field": "batch_size",
      "type": "number",
      "default": 1
    },
    "seed": {
      "node": "5",
      "field": "seed",
      "type": "number",
      "default": -1,
      "description": "-1이면 런타임에서 무작위 시드"
    },
    "steps": {
      "node": "5",
      "field": "steps",
      "type": "number",
      "default": 12,
      "description": "AIO 제작자 권장 12~14; 공식 Turbo 기준은 8"
    },
    "cfg": {
      "node": "5",
      "field": "cfg",
      "type": "number",
      "default": 1,
      "description": "Turbo 권장 CFG"
    },
    "sampler_name": {
      "node": "5",
      "field": "sampler_name",
      "type": "string",
      "default": "euler_ancestral"
    },
    "scheduler": {
      "node": "5",
      "field": "scheduler",
      "type": "string",
      "default": "simple"
    }
  }
}
