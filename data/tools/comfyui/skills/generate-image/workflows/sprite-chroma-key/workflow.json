{
  "1": {
    "class_type": "LoadImagesFromFolderKJ",
    "inputs": {
      "folder": "F:/repositories/comfyui/input/chromaseq",
      "width": -1,
      "height": -1,
      "keep_aspect_ratio": "crop",
      "image_load_cap": 0,
      "start_index": 0,
      "include_subfolders": false
    },
    "_meta": {
      "title": "frame seq"
    }
  },
  "2": {
    "class_type": "ChromaKeyUnmix",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "key_axis": "magenta (R,B high / G low)",
      "tolerance": 0.92,
      "edge_softness": 0,
      "unmix": true,
      "key_color_hex": "",
      "alpha_expand": 0
    },
    "_meta": {
      "title": "chroma key + unmix"
    }
  },
  "3": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Join 규약 보정"
    }
  },
  "4": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "2",
        2
      ],
      "alpha": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "RGBA join"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "chroma-key/frame",
      "images": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "save RGBA seq"
    }
  }
}
